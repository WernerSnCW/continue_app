# Dependencies
node_modules/
.pnpm-store/

# Build / dist output
dist/
build/
out/
*.tsbuildinfo

# Environment
.env
.env.local
.env.*.local

# Capacitor native projects.
#
# android/ is tracked, because it is no longer purely generated: the manifest
# carries hand-written Auto Backup rules that decide whether a reinstall gets
# someone's tally back. Left untracked, `cap add android` would regenerate the
# manifest on a fresh checkout and those rules would vanish without a diff.
# Its own android/.gitignore (from the Capacitor template) keeps the generated
# parts out — build output, the Gradle cache, local SDK paths, the copied web
# assets and the config files `cap sync` writes.
#
# ios/ stays ignored; there is no iOS project yet. Track it too if one is added
# and grows any hand-edited configuration.
apps/mobile/ios/
apps/mobile/.capacitor/

# Supabase local state
services/continue-api/supabase/.branches/
services/continue-api/supabase/.temp/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Claude Code local settings
.claude/settings.local.json

# Ad-hoc safety copies of cloud backups — personal data, never committed
*.backup.json

# Signing material. Also ignored in apps/mobile/android/.gitignore; repeated at
# the root so a keystore dropped anywhere in the tree is caught, not just under
# the native project.
*.jks
*.keystore
keystore.properties
