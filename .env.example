# Twitch / IGDB — IGDB auth goes through Twitch's OAuth client-credentials flow.
# Create an app at https://dev.twitch.tv/console/apps to get these.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Supabase — project URL and keys from the project's API settings.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-side only. Never ship this to the mobile app or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Mailbox password for the SMTP sender in services/continue-api/supabase/config.toml
# (contact@quietfoundry.io on Namecheap Private Email). Read by the Supabase CLI
# when pushing auth config; never committed.
SMTP_PASSWORD=
