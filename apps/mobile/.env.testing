# Testing build overrides — `pnpm build:testing`.
#
# Committed on purpose: nothing here is secret, and a test build has to behave
# the same on any machine.
#
# Vite loads .env then .env.testing for this mode, so .env.production is not
# read at all and cannot switch the mock back off. Equally, a release build
# never loads this file, so mocked billing cannot escape into one.
#
# Mocked billing stands in for Play Billing, which cannot be exercised at all
# until the app is installed from Play. Without it there is no way to reach the
# paid tier on a device, so paid features are untestable.
VITE_MOCK_PURCHASE=1
