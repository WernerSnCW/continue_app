# Vite only exposes variables prefixed with VITE_ to the client bundle.
# Both of these are safe to ship in the app.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set to 1 in test builds to compile in a simulated purchase, so the unlocked
# experience can be exercised on a real device before Play Billing exists.
# MUST be unset for any build that goes to the Play Store.
VITE_MOCK_PURCHASE=
